# The site's own origin. Used for canonical URLs, the sitemap and Open Graph
# metadata, so it must be the address visitors actually reach — not the API's.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the documentation lives. Left unset, the Docs links resolve to the
# repository's own documentation on GitHub, because the documentation site has
# not been rewritten for this product yet and linking to it would be worse than
# linking to something that is true.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com

# The repository every source, roadmap, licence and contribution link points at.
# A fork repoints this rather than editing components.
NEXT_PUBLIC_REPO_URL=https://github.com/visheshgubrani/docento
