# The Studio application's environment.
#
# Nothing here is required: every value has a default that works for a local
# checkout with `pnpm dev`, so the file exists to document what can be changed
# rather than to be filled in before the application starts.
#
# The version this replaces listed `NEXT_PUBLIC_API_BASE_URL` with `/api/v1`
# already on the end, `NEXT_PUBLIC_AUTH_BASE_URL`, and keys for a payment
# provider and a video vendor that are no longer in the product. The API base URL
# one was actively harmful: the SDK appends the mount itself, and a base URL that
# included it produced a doubled prefix and a `404`.

# --- Where the API is ---------------------------------------------------------
#
# Read on the server, so it names the API from this process's point of view: a
# container reaches it at a service name, a checkout at localhost, and a
# deployment behind one proxy at that proxy. It is an origin — scheme, host and
# port — with no path.
#
# This is also baked into the browser-facing proxy rules at *build* time, because
# Next evaluates `rewrites()` when it loads the config. A deployment that reaches
# the API somewhere else must set it before building, not only at run time.
API_INTERNAL_URL="http://localhost:4000"

# The same origin, for anything that runs in the browser. Optional: the
# application proxies `/api/v1` and `/api/auth` to `API_INTERNAL_URL` so the
# session cookie stays first-party, and no browser code needs an absolute API
# address. Set it only if something bypasses that proxy.
# NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Images -------------------------------------------------------------------
#
# Comma-separated hostnames that `next/image` may fetch from. Deployment
# specific, so it has no default: a hardcoded host silently breaks every image
# for a deployment that is not the one it was written for.
# NEXT_PUBLIC_IMAGE_HOSTS="cdn.example.com,images.example.com"

# --- Error reporting (optional) -----------------------------------------------
#
# Source-map upload needs all three. With any of them missing the build succeeds
# with no Sentry at all, which is the normal case for a self-hoster and for a
# contributor.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
