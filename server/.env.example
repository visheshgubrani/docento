# ==============================================================================
# DOCENTO SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docento?schema=public"

# Authentication & Sessions (Better Auth)
BETTER_AUTH_SECRET="your_better_auth_secret_minimum_32_characters_long"
BETTER_AUTH_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="your_jwt_secret_for_signing_tokens"

# Object Storage (Cloudflare R2 / AWS S3 compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="your_r2_bucket_name"
R2_ENDPOINT="https://<your_account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-public-cdn-domain.com"

# Video Infrastructure (Clipmux)
CLIPMUX_API_KEY="your_clipmux_api_key"
CLIPMUX_API_URL="https://api.clipmux.com"
CLIPMUX_CDN_URL="https://media.clipmux.com"
CLIPMUX_WEBHOOK_SECRET="your_clipmux_webhook_secret"

# Payments & SaaS Billing (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# AI Integration
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"

# Observability & Analytics (Optional)
SENTRY_DSN=""
POSTHOG_PROJECT_TOKEN=""
POSTHOG_HOST=""

# Transactional Email (Resend or Console for local dev)
EMAIL_PROVIDER="console" # "console" | "resend"
RESEND_API_KEY=""
EMAIL_FROM="Docento <noreply@docento.dev>"
