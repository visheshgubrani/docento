# Docento local development environment.
#
# Copy to `.env` and fill in the secrets. Generate each one with the command
# shown; do not reuse the placeholders below outside a local machine.
#
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# Postgres. The port matches the bundled docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/docento?schema=public"

# Public origin of the Studio application.
APP_URL="http://localhost:3000"

# Public origin of the API. Must be set explicitly in any deployment behind a
# proxy: without it, authentication falls back to deriving the origin from each
# request, which breaks callbacks and redirects.
API_URL="http://localhost:4000"

# The two authentication realms use separate secrets, so a leaked or rotated
# secret in one cannot forge a session in the other. Generate each with:
#   openssl rand -base64 48
#
# Left empty on purpose. A placeholder long enough to pass validation would mean
# a copy-and-run install starts up with publicly known signing keys, and nothing
# would say so. Empty fails validation at startup with the command above.
STAFF_AUTH_SECRET=""
LEARNER_AUTH_SECRET=""

# Encrypts provider credentials at rest. Losing this key means losing those
# credentials, so back it up wherever you keep secrets. Generate with:
#   openssl rand -hex 32
#
# Also empty on purpose. A zeroed key is valid hex, so it would validate and
# silently encrypt everything under a key that is in this repository.
ENCRYPTION_KEY=""

# --- Optional ---------------------------------------------------------------
# Everything below can be left unset. An unconfigured integration disables a
# feature and explains itself; it never prevents the process from starting.

# Extra origins allowed to make credentialed browser requests, comma separated.
# TRUSTED_ORIGINS="https://studio.example.com,https://learn.example.com"

# console | resend | smtp. `console` prints messages to stdout, which is enough
# to complete sign-up and password reset locally without an email account — and
# it is a real answer rather than a placeholder, so a self-hosted install needs
# no mail service at all.
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@localhost"
# Shown in an inbox instead of a bare address. Cosmetic, and worth setting: a
# bare address reads as machine-generated.
# EMAIL_FROM_NAME="Docento"

# --- Optional: email over SMTP ----------------------------------------------
# For an operator who already runs a mail server. STARTTLS is required by
# default: sending a password reset in plaintext because a server did not offer
# it is a downgrade nobody would notice from the configuration.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"      # true for implicit TLS on connect, usually port 465
# SMTP_REQUIRE_TLS="true"
# SMTP_USERNAME=""
# SMTP_PASSWORD="

# trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# --- Optional: storage ------------------------------------------------------
# Defaults to the local filesystem, which needs no external service. When the
# API and the worker run as separate containers they must mount the same
# directory, or the worker will silently fail to find files the API wrote.
# STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR="./.data/uploads"

# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# --- Optional: AI -----------------------------------------------------------
# Both providers are optional. A local OpenAI-compatible endpoint needs no API
# key, which is the intended path for a fully self-hosted install (Ollama, vLLM,
# llama.cpp).
# AI_DEFAULT_PROVIDER="openai-compatible"
# AI_OPENAI_BASE_URL="http://localhost:11434/v1"
# AI_OPENAI_MODEL="llama3.1"
# AI_OPENAI_API_KEY=""
# AI_ANTHROPIC_API_KEY=""
# AI_ANTHROPIC_MODEL=""

# --- Optional: video --------------------------------------------------------
# VIDEO_PROVIDER="local"
# OPENVOD_API_URL=""
# OPENVOD_API_KEY=""
# OPENVOD_WEBHOOK_SECRET=""

# --- Optional: payments -----------------------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# --- Optional: observability -------------------------------------------------
# Telemetry is opt-in and off by default.
# TELEMETRY_ENABLED="false"
# SENTRY_DSN=""
