{
  "name": "@docento/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Docento's shared design system: semantic tokens, typography, brand assets and presentation primitives.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./brand": "./src/brand/index.ts",
    "./fonts": "./src/fonts.ts",
    "./assets/*": "./assets/*",
    "./tokens": "./src/lib/read-tokens.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "brand:wordmark": "node scripts/build-wordmark.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "radix-ui": "^1.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@docento/config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.39.5",
    "fontkit": "^2.0.4",
    "geist": "^1.7.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
